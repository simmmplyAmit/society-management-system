# Database (Neon pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Neon: DATABASE_URL is the pooled URL (host contains "-pooler") used by the app.
# DIRECT_URL is the direct URL, used only for migrations (Vercel build, `prisma migrate deploy`).
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth + cron
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
CRON_SECRET="generate with: openssl rand -hex 32"

# Public URL used in email links (defaults to the Vercel production URL)
APP_URL="https://your-app.example.com"

# Set to "false" to switch off the email + mobile verification gate
# (e.g. before the providers below are configured). Default: required.
# REQUIRE_VERIFICATION=false

# Email via Resend (https://resend.com). EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=""
# Every society sends from this one address; emails show "<Society> via Society MS" as the
# sender and replies go to the society's committee (src/lib/notify/sender.ts).
EMAIL_FROM="Society MS <no-reply@your-domain.com>"

# SMS via MSG91 (https://msg91.com). India needs DLT-approved templates; create three
# MSG91 Flow templates and paste their ids. Variables are written ##name## in the text.
MSG91_AUTH_KEY=""
# otp:     "Your Society MS code is ##otp##. It is valid for 10 minutes. Do not share it."
MSG91_TEMPLATE_OTP=""
# due:     "Hi ##name##, maintenance of ##amount## for ##period## (##flat##) is pending. Pay by UPI to ##upi##."
MSG91_TEMPLATE_DUE=""
# receipt: "Hi ##name##, we received ##amount## maintenance for ##period## (##flat##). Thank you!"
MSG91_TEMPLATE_RECEIPT=""

# Without the provider keys, development (NODE_ENV != production) prints emails/SMS
# to the server console and shows the OTP on the verify screen. Production fails closed.

# Shared login rate limit (Upstash Redis, REST API). Without these, each server instance keeps
# its own in-memory count, which serverless deployments spread across instances.
# UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (Sentry). Server errors need SENTRY_DSN; browser errors need NEXT_PUBLIC_SENTRY_DSN
# (read at build time, so redeploy after setting it). Both can be the same DSN. Unset = no reporting.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Document storage (Cloudflare R2, private bucket). See docs/DOCUMENT-STORAGE.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# DOCUMENT_QUOTA_MB=1024
